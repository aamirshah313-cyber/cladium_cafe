# Copy to .env.local for local development only. Never commit real values.
# Keep development, preview/staging, and production credentials isolated:
# three separate Supabase projects, not one project shared between them.
# Placeholders only in this file — it is committed.

# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-development-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-development-publishable-key

# Server-only application configuration
#
# Two connections, two jobs — see docs/database-environments.md:
#   DATABASE_URL         port 6543, transaction pooler. Application request
#                        traffic only. Disable prepared statements on this one.
#   DIRECT_DATABASE_URL  port 5432, direct/session. Migrations and admin tasks
#                        only; migrations cannot run through a pooler.
# `npm run check:db-config` enforces these ports and sslmode=require.
DATABASE_URL=postgresql://user:password@pooled-host:6543/database?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@direct-host:5432/database?sslmode=require
SUPABASE_SERVICE_ROLE_KEY=replace-with-development-service-role-key
SESSION_SECRET=replace-with-at-least-32-random-bytes
CRON_SECRET=replace-with-an-independent-random-secret

# Text concierge — server only
ANTHROPIC_API_KEY=replace-with-development-anthropic-key

# Vapi browser voice — all server only; browser receives a short-lived JWT
VAPI_ORG_ID=replace-with-development-organization-id
VAPI_PRIVATE_KEY=replace-with-development-private-key
VAPI_ASSISTANT_EN_ID=replace-with-development-english-assistant-id
VAPI_ASSISTANT_UR_ID=replace-with-development-urdu-assistant-id
VAPI_WEBHOOK_HMAC_SECRET=replace-with-development-custom-credential-secret

# Server-authoritative launch feature flags
FEATURE_PUBLIC_SITE=true
FEATURE_TAKEAWAY_REQUESTS=false
FEATURE_BOOKING_REQUESTS=false
FEATURE_EVENT_REQUESTS=false
FEATURE_TEXT_CONCIERGE=false
FEATURE_VOICE_EN=false
FEATURE_VOICE_UR=false
FEATURE_WHATSAPP_CLOUD=false
FEATURE_META_MARKETING=false
FEATURE_ONLINE_PAYMENT=false

# Future integrations — leave unset until their release gates pass
META_PIXEL_ID=
META_DATASET_ID=
META_CONVERSIONS_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
